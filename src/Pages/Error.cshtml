@page
@model ErrorModel
@{
    ViewData["Title"] = "Page not found";
}

<div class="gh-error">
    <div class="gh-error-card">

        <!-- Big faded 404 in the corner -->
        <div class="gh-error-ghost" aria-hidden="true">404</div>

        <!-- Stick figure peeking in from the right edge with a magnifying glass -->
        <svg class="gh-error-peek" viewBox="0 0 90 150" width="108" height="180" role="img" aria-label="A curious stick figure peeking in from the edge with a magnifying glass">
            <g fill="none" stroke="#1F3A6E" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="80" cy="42" r="20" fill="#fff" />
                <path d="M62 27 L70 25" />
                <path d="M74 25 L82 27" />
                <circle cx="70" cy="54" r="2.5" />
                <path d="M90 86 L72 88" />
                <path d="M72 88 L64 86" />
                <circle cx="54" cy="82" r="11" fill="#e9eefb" />
                <path d="M90 128 L76 138 L66 138" />
            </g>
            <circle cx="66" cy="39" r="2.6" fill="#172033" />
            <circle cx="76" cy="39" r="2.6" fill="#172033" />
        </svg>

        <div class="gh-error-top">
            <div class="gh-error-label">404 · Page not found</div>
            <h1 class="gh-error-title">
                This page went out for milk and never
                <span class="gh-error-title-end">came back.</span>
            </h1>
            <p class="gh-error-text">We've checked under the couch, behind the fridge, and in the other tab you forgot about. Nothing.</p>

            <!-- Opens to list the usual reasons this page shows up -->
            <details class="gh-error-more">
                <summary>Read more</summary>
                <p class="gh-error-text">This can happen when you're:</p>
                <ul class="gh-error-text gh-error-reasons">
                    <li>Opening the Read, Update, or Delete page with an id that does not exist.</li>
                    <li>Saving changes on the Update page after the post was deleted (for example, by another user in a different tab).</li>
                    <li>Deleting a post that was already deleted.</li>
                </ul>
            </details>
        </div>

        <div class="gh-error-bottom">
            <!-- A joke excuse; "Try another excuse" swaps in the next one -->
            <div class="gh-error-excuse" aria-live="polite">
                <div class="gh-error-excuse-label">Official excuse #<span id="gh-excuse-no">404</span></div>
                <div class="gh-error-excuse-text" id="gh-excuse-text">The page is on vacation. No forwarding address.</div>
            </div>

            <div class="gh-error-actions">
                <a class="gh-error-btn gh-error-btn-primary" href="/">Take me home</a>
                <button type="button" class="gh-error-btn gh-error-btn-secondary" id="gh-excuse-next">Try another excuse</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cycle through the excuses; the number goes up by 13 each time, starting at 404 fun fun fun
        (function () {
            var excuses = [
                "The page is on vacation. No forwarding address.",
                "A squirrel chewed through that link.",
                "The id you asked for moved out last week.",
                "Someone deleted it, then deleted the evidence.",
                "It was here a second ago. We swear.",
                "The page is hiding. It owes us money."
            ];
            var count = 0;
            var text = document.getElementById("gh-excuse-text");
            var number = document.getElementById("gh-excuse-no");

            document.getElementById("gh-excuse-next").addEventListener("click", function () {
                count = count + 1;
                text.textContent = excuses[count % excuses.length];
                number.textContent = 404 + count * 13;
            });
        })();
    </script>
}
