<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/html">
<head>
    <meta charset="utf-8" />
    <base href="~/" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameHub</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico?v=2">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  
<link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
</head>
<body>
    <header class="gh-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light gh-nav" aria-label="Main">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img src="/images/gamehlogo.png" width="160" height="34" alt="GameHub" /></a>

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link gh-nav-link @GetActiveClass("/Product")" asp-area="" asp-page="/Product/Index">Posts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gh-nav-link @GetActiveClass("/About")" asp-area="" asp-page="/About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gh-nav-link @GetActiveClass("/Privacy")" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer gh-footer">
        <div class="container">
            &copy; 2026 - GAMEHUB
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

@functions {
    // Gives back "active" when the open page matches the link, so the link is highlighted
    public string GetActiveClass(string pageName)
    {
        // Find out which page is open right now
        var currentPage = "";
        var pageValue = ViewContext.RouteData.Values["page"];
        if (pageValue != null)
        {
            currentPage = pageValue.ToString();
        }

        var result = "";
        if (currentPage.StartsWith(pageName))
        {
            result = "active";
        }

        return result;
    }
}
