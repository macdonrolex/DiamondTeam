@page "{id}"
@using ContosoCrafts.WebSite.Services
@inject JsonFileProductService ProductService
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel

@{
	ViewData["Title"] = "Update page";
}

<div class="container mt-4">
	<div class="d-flex align-items-center flex-wrap mb-3">
    <a class="btn btn-secondary mr-3" asp-page="/Product/Index">
        Back to List
    </a>
	<h2 class="mb-0">Edit for @Model.Product.Title</h2>
	</div>

	<form method="post">
		<div asb-asp-validation-summary="ModleOnly" class ="text-danger"></div>
		@Html.HiddenFor(x => x.Product.Id)

		<div class="form-group">
			<label asp-for="Product.Title" class="control-label"></label>
			<input asp-for="Product.Title" class="form-control" />
			<span asp-validation-for="Product.Title" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Maker" class="control-label"></label>
			<input asp-for="Product.Maker" class="form-control" />
			<span asp-validation-for="Product.Maker" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Description" class="control-label"></label>
			<textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
			<span asp-validation-for="Product.Description" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Post" class="control-label"></label>
			<textarea asp-for="Product.Post" class="form-control" rows="6"></textarea>
			<span asp-validation-for="Product.Post" class="text-danger"></span>
		</div>
		
		
		<div class="form-group">
			<input type="submit" value="Save" class="btn btn-secondary" />
		</div>
	</form>
</div>