@page "{id}"
@using ContosoCrafts.WebSite.Models
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel

@{
	ViewData["Title"] = "Update page";
}

<div class="container py-5 update-page">
	<div class="update-top">
		<a class="update-back" asp-page="/Product/Index">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
			<span>Back to List</span>
		</a>
		<h1 class="update-title">Edit for @Model.Product.Title</h1>
	</div>

	<form method="post" class="update-card" novalidate>
		<div asp-validation-summary="ModelOnly" class="post-create-validation" role="alert"></div>
		@Html.HiddenFor(x => x.Product.Id)

		<div class="update-grid">

			<!-- Title -->
			<div class="update-field update-field-wide">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--title update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 8.5h11a4.5 4.5 0 0 1 4.3 5.9l-1 3a2.5 2.5 0 0 1-4.1 1L14.8 16h-5.6l-1.9 2.4a2.5 2.5 0 0 1-4.1-1l-1-3A4.5 4.5 0 0 1 6.5 8.5Z"/><path d="M7 11v4m-2-2h4m7-1h.01M18 14h.01"/></svg>
					<div class="update-body">
						<label asp-for="Product.Title" class="update-label">Game title</label>
						<input asp-for="Product.Title" class="update-input" placeholder="e.g. Stardew Valley" autocomplete="off" />
					</div>
				</div>
				<span asp-validation-for="Product.Title" class="post-create-error update-error"></span>
			</div>

			<!-- Genre -->
			<div class="update-field">
				<div class="update-control">
					<svg class="post-create-label-icon update-icon update-icon--genre" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.6 13.4 11 3.8H4v7.1l9.6 9.7a2 2 0 0 0 2.8 0l4.2-4.3a2 2 0 0 0 0-2.9Z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
					<div class="update-body">
						<label asp-for="Product.Genre" class="update-label">Genre</label>
						<select asp-for="Product.Genre" class="update-input update-select">
							@foreach (var genre in Enum.GetValues<GenreEnum>().Skip(1))
							{
								<option value=@genre>@genre.DisplayGenre()</option>
							}
						</select>
					</div>
					<svg class="update-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
				</div>
				<span asp-validation-for="Product.Genre" class="post-create-error update-error"></span>
			</div>

			<!-- Release year -->
			<div class="update-field">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--date update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
					<div class="update-body">
						<label asp-for="Product.ReleaseYear" class="update-label">Game release year</label>
						<input asp-for="Product.ReleaseYear" type="number" class="update-input" />
					</div>
				</div>
				<span asp-validation-for="Product.ReleaseYear" class="post-create-error update-error"></span>
			</div>

			<!-- Maker -->
			<div class="update-field update-field-wide">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--maker update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V7l8-4 8 4v13M2 20h20M8 10h2m4 0h2M8 14h2m4 0h2M10 20v-3h4v3"/></svg>
					<div class="update-body">
						<label asp-for="Product.Maker" class="update-label">Maker</label>
						<input asp-for="Product.Maker" class="update-input" placeholder="Studio or publisher" autocomplete="organization" />
					</div>
				</div>
				<span asp-validation-for="Product.Maker" class="post-create-error update-error"></span>
			</div>

			<!-- Description -->
			<div class="update-field update-field-wide">
				<div class="update-control update-control-tall">
					<svg class="post-create-label-icon post-create-label-icon--description update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 10h16M4 14h11M4 18h8"/></svg>
					<div class="update-body">
						<label asp-for="Product.Description" class="update-label">Description</label>
						<textarea asp-for="Product.Description" class="update-input update-textarea" rows="3" placeholder="A quick overview of the game"></textarea>
					</div>
				</div>
				<span asp-validation-for="Product.Description" class="post-create-error update-error"></span>
			</div>

			<!-- Post -->
			<div class="update-field update-field-wide">
				<div class="update-control update-control-tall">
					<svg class="post-create-label-icon post-create-label-icon--post update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 13h8m-8 4h8"/></svg>
					<div class="update-body">
						<label asp-for="Product.Post" class="update-label">Post</label>
						<textarea asp-for="Product.Post" class="update-input update-textarea update-textarea-post" rows="6" placeholder="What should players know about it?"></textarea>
					</div>
				</div>
				<span asp-validation-for="Product.Post" class="post-create-error update-error"></span>
			</div>

			<!-- Image -->
			<div class="update-field update-field-wide">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--image update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></svg>
					<div class="update-body">
						<label asp-for="Product.Image" class="update-label">Image</label>
						<input asp-for="Product.Image" class="update-input" placeholder="Image link or path" autocomplete="off" />
					</div>
				</div>
				<span asp-validation-for="Product.Image" class="post-create-error update-error"></span>
			</div>

			<!-- Shop link -->
			<div class="update-field">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--shop update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 8h18l-1.5 13h-15L3 8Zm4 0a5 5 0 0 1 10 0"/></svg>
					<div class="update-body">
						<label asp-for="Product.ShopLink" class="update-label">Shop link</label>
						<input type="url" asp-for="Product.ShopLink" class="update-input" placeholder="www.amazon.com/..." autocomplete="url" />
					</div>
				</div>
				<span asp-validation-for="Product.ShopLink" class="post-create-error update-error"></span>
			</div>

			<!-- Rating link -->
			<div class="update-field">
				<div class="update-control">
					<svg class="post-create-label-icon post-create-label-icon--rating update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>
					<div class="update-body">
						<label asp-for="Product.RatingLink" class="update-label">Rating link</label>
						<input type="url" asp-for="Product.RatingLink" class="update-input" placeholder="www.metacritic.com/game/..." autocomplete="off" />
					</div>
				</div>
				<span asp-validation-for="Product.RatingLink" class="post-create-error update-error"></span>
			</div>

			<!-- Multiplayer -->
			<div class="update-field update-field-wide">
				<label class="update-control update-control-toggle" asp-for="Product.IsMultiplayer">
					<svg class="post-create-label-icon post-create-label-icon--multiplayer update-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.25 7a2.75 2.75 0 1 0 5.5 0a2.75 2.75 0 1 0-5.5 0M7.5 19v-.5a4 4 0 0 1 4-4h1a4 4 0 0 1 4 4v.5M2.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M1.5 18.5v-.5a3.5 3.5 0 0 1 3.5-3.5M17.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M22.5 18.5v-.5a3.5 3.5 0 0 0-3.5-3.5"/></svg>
					<span class="update-toggle-text">Is this a multi-player game?</span>
					<input asp-for="Product.IsMultiplayer" type="checkbox" class="update-switch" />
				</label>
				<span asp-validation-for="Product.IsMultiplayer" class="post-create-error update-error"></span>
			</div>

		</div>

		<div class="update-actions">
			<a asp-page="/Product/Index" class="update-cancel">Cancel</a>
			<button type="submit" class="update-save">Save changes</button>
		</div>
	</form>
</div>

@section Scripts 
{
	<partial name="_ValidationScriptsPartial" />
}