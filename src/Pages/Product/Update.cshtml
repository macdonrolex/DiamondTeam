@page "{id}"
@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@inject JsonFileProductService ProductService
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel

@{
	ViewData["Title"] = "Update page";
}

<div class="container mt-4">
	<div class="d-flex align-items-center flex-wrap mb-3">
    <a class="btn btn-secondary mr-3" asp-page="/Product/Index">
        Back to List
    </a>
	<h2 class="mb-0">Edit for @Model.Product.Title</h2>
	</div>

	<form method="post">
		<div asb-asp-validation-summary="ModleOnly" class ="text-danger"></div>
		@Html.HiddenFor(x => x.Product.Id)

		<div class="form-group">
			<label asp-for="Product.Title" class="control-label"></label>
			<input asp-for="Product.Title" class="form-control" placeholder="The title of the post"/>
			<span asp-validation-for="Product.Title" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Genre" class="control-label"></label>
			<select asp-for="Product.Genre" class="form-control">
				<option value="@GenreEnum.Action">@GenreEnum.Action.DisplayGenre()</option>
				<option value="@GenreEnum.Adventure">@GenreEnum.Adventure.DisplayGenre()</option>
				<option value="@GenreEnum.Platform">@GenreEnum.Platform.DisplayGenre()</option>
				<option value="@GenreEnum.Shooter">@GenreEnum.Shooter.DisplayGenre()</option>
				<option value="@GenreEnum.Fighting">@GenreEnum.Fighting.DisplayGenre()</option>
				<option value="@GenreEnum.Stealth">@GenreEnum.Stealth.DisplayGenre()</option>
				<option value="@GenreEnum.Strategy">@GenreEnum.Strategy.DisplayGenre()</option>
				<option value="@GenreEnum.Sandbox">@GenreEnum.Sandbox.DisplayGenre()</option>
				<option value="@GenreEnum.Rhythm">@GenreEnum.Rhythm.DisplayGenre()</option>
				<option value="@GenreEnum.Undefined">@GenreEnum.Undefined.DisplayGenre()</option>
			</select>
			<span asp-validation-for="Product.Genre" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.ReleaseYear" class="control-label"></label>
			<input asp-for="Product.ReleaseYear" type="number" class="form-control" />
			<span asp-validation-for="Product.ReleaseYear" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Maker" class="control-label"></label>
			<input asp-for="Product.Maker" class="form-control" placeholder="Your name"/>
			<span asp-validation-for="Product.Maker" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Description" class="control-label"></label>
			<textarea asp-for="Product.Description" class="form-control" rows="3" placeholder="Brief summary of your post"></textarea>
			<span asp-validation-for="Product.Description" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Post" class="control-label"></label>
			<textarea asp-for="Product.Post" class="form-control" rows="6" placeholder="Your content"></textarea>
			<span asp-validation-for="Product.Post" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.Image" class="control-label"></label>
			<input asp-for="Product.Image" class="form-control" />
			<span asp-validation-for="Product.Image" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.ShopLink" class="control-label"></label>
			<input type="url" asp-for="Product.ShopLink" class="form-control" placeholder="www.amazon.com/..."/>
			<span asp-validation-for="Product.ShopLink" class="text-danger"></span>
		</div>
		
		<div class="form-group">
			<label asp-for="Product.RatingLink" class="control-label"></label>
			<input type="url" asp-for="Product.RatingLink" class="form-control" placeholder="www.metacritic.com/game/..."/>
			<span asp-validation-for="Product.RatingLink" class="text-danger"></span>
		</div>
		
		<div class="post-create-field">
			<label asp-for="Product.IsMultiplayer" class="post-create-label">
				<svg class="post-create-label-icon post-create-label-icon--multiplayer" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.25 7a2.75 2.75 0 1 0 5.5 0a2.75 2.75 0 1 0-5.5 0M7.5 19v-.5a4 4 0 0 1 4-4h1a4 4 0 0 1 4 4v.5M2.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M1.5 18.5v-.5a3.5 3.5 0 0 1 3.5-3.5M17.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M22.5 18.5v-.5a3.5 3.5 0 0 0-3.5-3.5"/></svg>
				<span>Is this a multi-player game?</span>
			</label>
			<input asp-for="Product.IsMultiplayer" class="form-control post-create-input" type="checkbox" />
			<span asp-validation-for="Product.IsMultiplayer" class="post-create-error"></span>
		</div>
		
		
		<div class="form-group">
			<input type="submit" value="Save" class="btn btn-secondary" />
		</div>
	</form>
</div>