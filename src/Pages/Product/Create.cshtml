@page
@using ContosoCrafts.WebSite.Models
@model ContosoCrafts.WebSite.Pages.Product.CreateModel

<div class="container py-5 post-create-page">
    <div class="post-create-card">
        <header class="post-create-header">
            <span class="post-create-eyebrow">GAMEHUB · COMMUNITY LIBRARY</span>
            <h1>Add a post</h1>
            <p>Share a game post with the community. Add the details below to get it listed.</p>
        </header>

        <form method="post" enctype="multipart/form-data" class="post-create-form" id="postCreateForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="post-create-validation" role="alert"></div>

            <div class="post-create-grid">
                <div class="post-create-field">
                    <label asp-for="Product.Title" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--title" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 8.5h11a4.5 4.5 0 0 1 4.3 5.9l-1 3a2.5 2.5 0 0 1-4.1 1L14.8 16h-5.6l-1.9 2.4a2.5 2.5 0 0 1-4.1-1l-1-3A4.5 4.5 0 0 1 6.5 8.5Z"/><path d="M7 11v4m-2-2h4m7-1h.01M18 14h.01"/></svg>
                        <span>Game title</span>
                    </label>
                    <input asp-for="Product.Title" class="form-control post-create-input" placeholder="e.g. Stardew Valley" autocomplete="off" />
                    <span asp-validation-for="Product.Title" class="post-create-error"></span>
                </div>

                <div class="post-create-field">
                    <label asp-for="Product.Maker" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--maker" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V7l8-4 8 4v13M2 20h20M8 10h2m4 0h2M8 14h2m4 0h2M10 20v-3h4v3"/></svg>
                        <span>Maker</span>
                    </label>
                    <input asp-for="Product.Maker" class="form-control post-create-input" placeholder="Studio or publisher" autocomplete="organization" />
                    <span asp-validation-for="Product.Maker" class="post-create-error"></span>
                </div>

                <div class="post-create-field post-create-field-wide">
                    <label asp-for="Product.Description" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--description" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 10h16M4 14h11M4 18h8"/></svg>
                        <span>Description</span>
                    </label>
                    <textarea asp-for="Product.Description" class="form-control post-create-input post-create-textarea" rows="3" placeholder="A quick overview of the game"></textarea>
                    <span asp-validation-for="Product.Description" class="post-create-error"></span>
                </div>

                <div class="post-create-field">
                    <label asp-for="Product.ReleaseYear" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--date" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
                        <span>Game Release Year</span>
                    </label>
                    <input asp-for="Product.ReleaseYear" type="number" value=@DateTime.Now.Year class="form-control post-create-input" />
                    <span asp-validation-for="Product.ReleaseYear" class="post-create-error"></span>
                </div>
                <div class="post-create-field">
                    <label asp-for="Product.Genre" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--genre" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20.6 13.4 11 3.8H4v7.1l9.6 9.7a2 2 0 0 0 2.8 0l4.2-4.3a2 2 0 0 0 0-2.9Z" />
                            <circle cx="7.5" cy="7.5" r="1" />
                        </svg>
                        <span>Genre</span>
                    </label>
                    <select asp-for="Product.Genre" class="form-control post-create-input post-create-genre">
                        @foreach (var genre in Enum.GetValues<GenreEnum>().Skip(1))
                        {
                            <option value=@genre>@genre.DisplayGenre()</option>
                        }
                    </select>
                    <span asp-validation-for="Product.Genre" class="post-create-error"></span>
                </div>

                

                <div class="post-create-field post-create-field-wide">
                    <label asp-for="Product.Post" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--post" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 13h8m-8 4h8"/></svg>
                        <span>Post</span>
                    </label>
                    <textarea asp-for="Product.Post" class="form-control post-create-input post-create-textarea post-create-post" rows="5" placeholder="What should players know about it?"></textarea>
                    <span asp-validation-for="Product.Post" class="post-create-error"></span>
                </div>

                <div class="post-create-field post-create-field-wide">
                    <label asp-for="ImageFile" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--image" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></svg>
                        <span>Upload game image</span>
                    </label>
                    <div class="post-create-upload-control">
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" class="sr-only post-create-file-input" />
                        <label for="ImageFile" class="btn btn-primary rounded-pill post-create-file-button">
                            <span class="post-create-file-button-icon" aria-hidden="true">↑</span>
                            <span>Choose image</span>
                        </label>
                        <span id="selectedImageName" class="post-create-file-name" aria-live="polite">No image selected</span>
                    </div>
                    <small class="post-create-hint">Choose a JPG, PNG, GIF, or WEBP file, up to 10 MB.</small>
                    <span asp-validation-for="ImageFile" class="post-create-error"></span>
                </div>
                <div class="post-create-field">
                    <label asp-for="Product.RatingLink" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--rating" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>
                        <span>Rating link</span>
                    </label>
                    <input asp-for="Product.RatingLink" class="form-control post-create-input" placeholder="Rating Link" autocomplete="off" />
                    <span asp-validation-for="Product.RatingLink" class="post-create-error"></span>
                </div>

                <div class="post-create-field">
                    <label asp-for="Product.ShopLink" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--shop" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 8h18l-1.5 13h-15L3 8Zm4 0a5 5 0 0 1 10 0"/></svg>
                        <span>Shop link</span>
                    </label>
                    <input asp-for="Product.ShopLink" class="form-control post-create-input" placeholder="Shop link" autocomplete="url" />
                    <span asp-validation-for="Product.ShopLink" class="post-create-error"></span>
                </div>
                
                <div class="post-create-field">
                    <label asp-for="Product.IsMultiplayer" class="post-create-label">
                        <svg class="post-create-label-icon post-create-label-icon--multiplayer" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.25 7a2.75 2.75 0 1 0 5.5 0a2.75 2.75 0 1 0-5.5 0M7.5 19v-.5a4 4 0 0 1 4-4h1a4 4 0 0 1 4 4v.5M2.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M1.5 18.5v-.5a3.5 3.5 0 0 1 3.5-3.5M17.5 9.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M22.5 18.5v-.5a3.5 3.5 0 0 0-3.5-3.5"/></svg>
                        <span>Is this a multi-player game?</span>
                        <input asp-for="Product.IsMultiplayer" class="form-check post-create-checkbox" type="checkbox" />
                    </label>
                </div>
            </div>

            <div class="post-create-actions">
                <a asp-page="/Product/Index" class="post-create-cancel">Cancel</a>
                <button type="submit" class="btn post-create-submit" id="postCreateSubmit">
                    <span class="post-create-submit-label">Add Post</span>
                    <span class="post-create-submit-icon" aria-hidden="true">↗</span>
                    <span class="post-create-spinner" aria-hidden="true"></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Show the selected image filename beside the upload button.
        (() => {
            const imageInput = document.getElementById("ImageFile");
            const imageName = document.getElementById("selectedImageName");

            if (!imageInput || !imageName) return;

            imageInput.addEventListener("change", () => {
                const selectedFile = imageInput.files && imageInput.files[0];
                imageName.textContent = selectedFile ? selectedFile.name : "No image selected";
                imageName.classList.toggle("has-file", Boolean(selectedFile));
            });
        })();
    </script>
}