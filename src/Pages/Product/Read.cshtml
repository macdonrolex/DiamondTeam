@page
@using ContosoCrafts.WebSite.Models
@model ContosoCrafts.WebSite.Pages.Product.ReadModel
@{
ViewData["Title"] = "Product Details";
}
<div class="container product-detail-page">
    <div class="product-detail-topbar">
        <a class="btn btn-secondary" asp-page="/Product/Index">
    <a class="btn btn-secondary mr-3" asp-page="/Product/Index">
        Back to List
    </a>
    <h2 class="mb-0 mr-3">@Model.Product.Title</h2>
    @switch (string.IsNullOrWhiteSpace(Model.Product.Maker))
    {
	    case true:
		    <span class="product-maker">Maker Unknown</span>
		    break;
	    case false:
		    <span class="product-maker">@Model.Product.Maker</span>
		    break;
    }
    <span class="game-genre">@Model.Product.Genre.DisplayGenre()</span>
	</div>
    <h1>@Model.Product.Title</h1>
	
    <div class="product-detail-hero">
        <img src="@Model.Product.Image" alt="@Model.Product.Title" />
    </div>

    <div class="product-detail-layout">
        <main class="product-detail-story">
            <div class="product-detail-meta">
                <span class="product-detail-maker">
                    @(string.IsNullOrWhiteSpace(Model.Product.Maker)
                        ? "Maker Unknown"
                        : Model.Product.Maker)
                </span>
                <span class="game-genre">
                    @Model.Product.Genre.DisplayGenre()
                </span>
            </div>
            

            
		@if (!string.IsNullOrWhiteSpace(Model.Product.ShopLink))
		{
			<a class="btn btn-secondary" href="@Model.Product.ShopLink">Buy </a>
		}
		@if (!string.IsNullOrWhiteSpace(Model.Product.RatingLink))
		{
                    <a class="btn btn-secondary" href="@Model.Product.RatingLink">
                        Game Rating
                    </a>
		}
            </div>

            <div class="product-detail-copy">
                <p>@Model.Product.Post</p>
	</div>

            <div class="product-detail-admin">
                <a class="btn btn-secondary"
                   asp-page="/Product/Update"
                   asp-route-id="@Model.Product.Id">Edit</a>
                <a class="btn btn-danger"
                   asp-page="/Product/Delete"
                   asp-route-id="@Model.Product.Id">Delete</a>
	</div>
	
        <aside class="product-detail-sidebar">
            <section class="product-author-card">
                <h2>Post Details</h2>
                <p class="product-sidebar-label">Maker</p>
                <p class="product-sidebar-value">
                    @(string.IsNullOrWhiteSpace(Model.Product.Maker)
                        ? "Maker Unknown"
                        : Model.Product.Maker)
                </p>
                <p class="product-sidebar-label">Genre</p>
                <p class="product-sidebar-value">
                    @Model.Product.Genre.DisplayGenre()
                </p>
            </section>
	
            <section class="related-products-card">
                <h2>More Posts</h2>
    
</div>
