@page
@model ContosoCrafts.WebSite.Pages.Product.ReadModel
@{
ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <h2>@Model.Product.Title</h2>
    <img src="@Model.Product.Image" alt="@Model.Product.Title" width="300" />

    <div class="mt-3">
        <a class="btn btn-secondary" asp-page="/Product/Index">Back to List</a>
    </div>
</div>
