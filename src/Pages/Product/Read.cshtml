@page
@model ContosoCrafts.WebSite.Pages.Product.ReadModel
@{
ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
	<div class="d-flex align-items-center flex-wrap mb-3">
    <a class="btn btn-secondary mr-3" asp-page="/Product/Index">
        Back to List
    </a>
    <h2 class="mb-0">@Model.Product.Title</h2>
	</div>
	
    <img class="mx-auto d-block img-fluid" src="@Model.Product.Image" alt="@Model.Product.Title" width="300" />
	<div class="p-3">
        @*Only display the link buttons if the author provides something that's not empty*@
		@if (!string.IsNullOrWhiteSpace(Model.Product.ShopLink))
		{
			<a class="btn btn-secondary" href="@Model.Product.ShopLink">Buy </a>
		}
		@if (!string.IsNullOrWhiteSpace(Model.Product.RatingLink))
		{
			<a class="btn btn-secondary" href="@Model.Product.RatingLink">Game Rating</a>
		}
		<p class="descenter">@Model.Product.Post</p>
	</div>
	<div class="d-flex justify-content-end mt-3">
		<a class="btn btn-secondary ml-3" asp-page="/Product/Update" asp-route-id="@Model.Product.Id">Edit</a>
	</div>
	
	
    
</div>
