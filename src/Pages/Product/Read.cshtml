@page
@model ContosoCrafts.WebSite.Pages.Product.ReadModel
@{
ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <h2>@Model.Product.Title</h2>
    <img src="@Model.Product.Image" alt="@Model.Product.Title" width="300" />
	<div>
		<p>@Model.Product.Post</p>
	</div>
	
    <div class="mt-3">
        <a class="btn btn-secondary" asp-page="/Product/Index">Back to List</a>

		@*Only display the link buttons if the author provides something that's not empty*@
		@if (!string.IsNullOrWhiteSpace(Model.Product.ShopLink))
		{
			<a class="btn btn-secondary" href="@Model.Product.ShopLink">Buy the game!</a>
		}
		@if (!string.IsNullOrWhiteSpace(Model.Product.ShopLink))
		{
			<a class="btn btn-secondary" href="@Model.Product.RatingLink">Check the ratings of this game!</a>
		}

    </div>
</div>
