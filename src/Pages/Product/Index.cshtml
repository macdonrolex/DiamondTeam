@page
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Reviews";
}

<div class="container product-list-page">
    <header class="product-list-heading">
        <div>
            <span class="product-list-eyebrow">POSTS PAGE</span>
            <h1 class="product-list-title">Reviews</h1>
            <p class="product-list-subtitle">Browse your collection of posts.</p>
        </div>
        <a asp-page="/Product/Create" class="product-add-button">
            <span class="product-add-icon" aria-hidden="true">+</span>
            <span>Add a Post</span>
        </a>
    </header>

    @if (Model.Products == null || !Model.Products.Any())
    {
        <div class="product-list-empty">
            <h2>Your library is ready for its first Post</h2>
            <p>Add a Post to see it here.</p>
        </div>
    }
    @if (Model.Products != null && Model.Products.Any())
    {
        <section class="product-list" aria-label="Game products">
            @foreach (var product in Model.PagedProducts)
            {
                <article class="product-list-row">
                    <div class="product-added-date">
                        <span class="product-meta-label">Added</span>
                        @if (product.DateAdded.HasValue)
                        {
                            <time class="product-date-value" datetime="@product.DateAdded.Value.ToString("yyyy-MM-dd")">
                                @product.DateAdded.Value.ToLocalTime().ToString("MMM d, yyyy")
                            </time>
                        }
                        @if (!product.DateAdded.HasValue)
                        {
                            <span class="product-date-value product-date-unknown">Date not recorded</span>
                        }
                    </div>

                    <a class="product-thumb-link" asp-page="/Product/Read" asp-route-id="@product.Id" aria-label="View @product.Title">
                        <div class="product-thumb">
                            <img src="@product.Image" alt="@product.Title" loading="lazy" />
                            <span class="product-thumb-title">@product.Title</span>
                        </div>
                    </a>

                    <div class="product-summary">
                        @if (!string.IsNullOrWhiteSpace(product.Maker))
                        {
                            <span class="product-maker">@product.Maker</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(product.Genre.ToString()))
                        {
                            <span class="product-genre">@product.Genre</span>
                        }
                     
                        <p class="product-description">@product.Description</p>
                    </div>

                    <div class="product-row-actions">
                        <a class="product-action product-action-details" asp-page="/Product/Read" asp-route-id="@product.Id">More Info</a>
                        <a class="product-action product-action-edit" asp-page="/Product/Update" asp-route-id="@product.Id">Edit</a>
                        <a class="product-action product-action-delete" asp-page="/Product/Delete" asp-route-id="@product.Id">Delete</a>
                    </div>
                </article>
            }
        </section>

        @* Show four posts per page with the same bottom pill navigation as the front page. *@
        <nav class="product-pager" aria-label="Product pages">
            @if (Model.CurrentPage > 1)
            {
                <a class="pager-button pager-prev" asp-page="/Product/Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">
                    <span aria-hidden="true">&larr;</span> Previous
                </a>
            }
            @if (Model.CurrentPage <= 1)
            {
                <button class="pager-button pager-prev" type="button" disabled>
                    <span aria-hidden="true">&larr;</span> Previous
                </button>
            }

            <span class="pager-status">Page @Model.CurrentPage of @Model.TotalPages</span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pager-button pager-next" asp-page="/Product/Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                    Next <span aria-hidden="true">&rarr;</span>
                </a>
            }
            @if (Model.CurrentPage >= Model.TotalPages)
            {
                <button class="pager-button pager-next" type="button" disabled>
                    Next <span aria-hidden="true">&rarr;</span>
                </button>
            }
        </nav>
    }
</div>

@section Scripts {
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // Show a short success toast after the saved post appears in the list.
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });
        </script>
    }
}