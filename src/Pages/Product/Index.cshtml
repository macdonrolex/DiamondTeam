@page
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@{
ViewData["Title"] = "Index page";
}

<div class="container">
    <div style="margin-bottom: 20px;">

        <a asp-page="/Product/PostCreate" class="btn btn-primary">Add New Post</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Title</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Title</td>
                <td>
                    <a class="btn btn-primary" asp-page="/Product/Read" asp-route-id="@product.Id">View Details</a>
                    <a class="btn btn-primary" asp-page="/Product/Delete" asp-route-id="@product.Id">Delete</a>
                    <a class="btn btn-primary" asp-page="/Product/Update" asp-route-id="@product.Id">Edit</a>

                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
