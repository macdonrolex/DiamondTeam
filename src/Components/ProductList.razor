@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService
@using Microsoft.AspNetCore.Components

<div class="row">
    @* Side by side on wider screens, stacked on phones *@
    <div class="col-12 col-md-6">
        @* Live search controls for front-page posts. *@
        <div class="product-search mb-4" role="search">
            @* Visible label so both fields are easy to identify *@
            <label class="filter-label" for="post-search">Search</label>
            @* Pill-shaped search box with the icon at the front. *@
            <div class="search-pill">
                @* The icon sits in a span so the number of spans on the page stays the same as before. *@
                <span class="search-pill-icon-wrap" aria-hidden="true"><svg class="search-pill-icon" viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg></span>
                @* Bind each keystroke to the search text and reset pagination afterward. *@
                <input id="post-search" class="search-pill-input" type="search" aria-label="Search posts" placeholder="Search posts by title or text..." @bind="SearchQuery" @bind:event="oninput" @bind:after="ResetSearchPage"/>
                @if (string.IsNullOrWhiteSpace(SearchQuery) == false)
                {
                    <button class="search-pill-clear" type="button" @onclick="ClearSearch" id="Clear">Clear</button>
                }
            </div>
            <small class="form-text search-pill-count">@FilteredProducts.Count() posts found</small>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="genre-filter mb-4">
            @* Visible label for the genre filter *@
            <label class="filter-label" for="genre_search">Genre</label>
            @* Bind the selected genre to the genre query and reset pagination afterward. *@
            @* Pill-shaped genre filter with a tag icon at the front and an arrow at the end. *@
            @* It gets the "is-active" look while a genre is selected. *@
            <div class="search-pill @(GenreQuery == null ? "" : "is-active")" id="GenrePill">
                <svg class="search-pill-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.6 13.4 11 3.8H4v7.1l9.6 9.7a2 2 0 0 0 2.8 0l4.2-4.3a2 2 0 0 0 0-2.9Z" /><circle cx="7.5" cy="7.5" r="1" /></svg>
                <select id="genre_search" class="search-pill-input search-pill-select" @bind="GenreQuery" @bind:event="onchange" @bind:after="ResetSearchPage">
                    <option value="">All Genres</option>
                    @foreach (var genre in Enum.GetValues<GenreEnum>().Skip(1))
                    {
                        <option value=@genre>@genre.DisplayGenre()</option>
                    }
                </select>
                <svg class="search-pill-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
                @* Reset only the genre, shown while a genre is selected *@
                @if (GenreQuery != null)
                {
                    <button class="search-pill-clear" type="button" @onclick="ResetGenre" id="ResetGenre" aria-label="Reset genre filter">Reset</button>
                }
            </div>
            @* Says which genre is applied, so the selected filter is easy to spot *@
            <small class="form-text search-pill-count" id="GenreStatus">
                @if (GenreQuery == null)
                {
                    @:Showing all genres
                }
                else
                {
                    @:Filtered by <strong>@GenreQuery.Value.DisplayGenre()</strong>
                }
            </small>
        </div>
    </div>
</div>
@if (FilteredProducts.Any() == false)
{
    <div class="alert alert-info text-center mt-3" role="status">No matching post found.</div>
}

@* Shown when the visitor opens a post that was deleted in the meantime *@
@if (string.IsNullOrEmpty(ProductMessage) == false)
{
    <div class="alert alert-warning text-center mt-3" role="alert" id="ProductMessage">@ProductMessage</div>
}

<div class="card-columns">
@* Display only the matching posts on the current page. *@
@foreach (var product in FilteredProducts.Skip((CurrentPage - 1) * PageSize).Take(PageSize))
    {
         <div class="card game-card border-0">
            <div class="card-img game-card-image" style="background-image: url('@product.Image');">
                <div class="game-card-title">@product.Title</div>
            </div>
            <div class="game-card-menu">
                <button class="game-card-more-info" type="button" @onclick="(e => SelectProduct(product.Id))" id="MoreInfoButton_@product.Id"data-toggle="modal" data-target="#productModal">More Info</button>
            </div>
        </div>
    }
</div>
<div class="product-pager" aria-label="Product pages">
    <button class="pager-button pager-prev" type="button" @onclick="PreviousPage" disabled="@(CurrentPage == 1)" id="previousButton">
        <span aria-hidden="true">&larr;</span> Previous
    </button>
    <span class="pager-status">Page @CurrentPage of @TotalPages</span>
    <button class="pager-button pager-next" type="button" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" id="NextButton">
        Next <span aria-hidden="true">&rarr;</span>
    </button>
</div>

@* Modal for displaying the selected product's details. *@
@if (SelectedProduct != null)
{
    <div class="modal-backdrop fade show" @onclick="CloseProductModal"></div>
    <div class="modal fade show d-block" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@SelectedProduct.Title</h5>
                    <button type="button" class="close" @onclick="CloseProductModal" aria-label="Close">
                        <span aria-hidden="true" id="xButton">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card">
                        <div class="card-img" style="background-image: url('@SelectedProduct.Image');">
                        </div>
                        <div class="card-body">
                            <p class="card-text">@SelectedProduct.Description</p>
                        </div>
                    </div>
                </div>

                @*vote feature*@
                <div class="voting">
                    @{
                        string voteText = VoteCount + " " + VoteLabel;
                        if (VoteCount == 0)
                        {
                            voteText = "Be the first to vote!";
                        }

                        <span>@voteText</span>
                    }
                    @for (int i = 1; i < 6; i++)
                    {

                        // Current star button to display
                        var currentStar = i;

                        // The class for star button
                        string starClass = "fa fa-star";

                        // Example: CurrentRating = 3. It means we need to make the first 3 stars checked(shiny)
                        if (currentStar <= CurrentRating)
                        {
                            starClass = "fa fa-star checked";
                        }
                        <span class=@starClass @onclick="(e => SubmitRating(currentStar))"></span>
                    }
                </div>
                <div class="modal-footer my-modal-footer">

                    @*comment submit*@
                    <div class="comment-submit">

                        @* comment input field *@
                        <input class="form-control" type="text" placeholder="Add a comment (max. 200)" maxlength="200" @onchange="(e) => UpdateCommentText(e.Value.ToString())" value="@NewCommentText"/>

                        @* comment submit button *@
                        <button @onclick="(e) => { ProductService.AddCommentToProduct(SelectedProduct, NewCommentText); RefreshCommentInput(); }" class="btn btn-success" data-toggle="modal" id="SubmitComment">
                            <svg class="submit-comment-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M5.5 4.5 20 12 5.5 19.5 7 14.4h4.5V9.6H7z"
                                      fill="currentColor"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>
                
                @* Display all comments *@
                <div class="comment-list">
                    @foreach (var comment in Enumerable.Reverse(SelectedProduct.CommentList))
                    {
                        <div class="comment-box">
                            
                            @* display the icon, like and dislike*@
                            <div class=comment-info>
                                <svg class="comment-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M8 8a4 4 0 1 0 8 0a4 4 0 1 0-8 0M5 20v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1"/>
                                </svg>
                                <div class="comment-reactions">
                                    <button type="button" class="comment-like" id="CommentLike" aria-label="Like (@comment.LikeCount)" @onclick="(e => LikeComment(comment))">
                                        <span class="fa fa-thumbs-up" aria-hidden="true"></span>
                                        <span id="LikeCount">@comment.LikeCount</span>
                                    </button>

                                    <button type="button" class="comment-dislike" id="CommentDislike" aria-label="Dislike (@comment.DislikeCount)" @onclick="(e => DislikeComment(comment))">
                                        <span class="fa fa-thumbs-down" aria-hidden="true"></span>
                                        <span id="DislikeCount">@comment.DislikeCount</span>
                                    </button>
                                </div>
                            </div>
                            
                            @* display the comment *@
                            <div class="text-break">@comment.Comment</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

@code
{   
    // Currently displayed game post
    public ProductModel SelectedProduct;

    // Id of the game post
    public string SelectedProductId;

    // Message shown when the chosen post no longer exists, empty otherwise
    public string ProductMessage;

    // Average rating of the selected game post
    public int CurrentRating = 0;

    // Number of votes the selected game post has received
    public int VoteCount = 0;

    // Text shown next to the vote count ("Vote" or "Votes")
    public string VoteLabel;

    // Number of game posts shown on each page
    public const int PageSize = 6;

    // Page currently displayed, starting from 1
    public int CurrentPage = 1;

    // The new comment text to store
    public string NewCommentText;

    // Total number of pages, calculated from the number of game posts (at least 1)
    public int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredProducts.Count() / (double)PageSize));

    // Text used to filter home-page posts as the visitor types.
    public string SearchQuery { get; set; } = string.Empty;

    // Cache filtered posts so each render avoids rereading the JSON file.
    public List<ProductModel> FilteredProducts { get; set; } = new();
    
    // The selected genre type in the filter, null means all genre
    public GenreEnum? GenreQuery { get; set; } = null;
    
    /// <summary>
    /// Load the posts when Blazor first creates this component.
    /// </summary>
    protected override void OnInitialized()
    {
        RefreshFilteredProducts();
    }
    
    /// <summary>
    /// Rebuild the list of posts that match the current filter.
    /// First filter: text query filter
    /// Second filter: genre query filter
    /// </summary>
    public void RefreshFilteredProducts()
    {
        // Get the full list before applying search filters.
        var products = Enumerable.Reverse(ProductService.GetAllData()).ToList();;
        
        // Apply text filter
        products = TextFilter(products);
        
        // Apply Genre filter
        products = GenreFilter(products);
        
        // Filter current displayed posts
        FilteredProducts = products;
    }

    /// <summary>
    /// Keeps only the posts whose title, description, or maker contains the current search text.
    /// </summary>
    /// <param name="list">The posts to filter</param>
    /// <returns>The posts that match the search text, or the given list when the search text is empty</returns>
    public List<ProductModel> TextFilter(List<ProductModel> list)
    {
        // Remove extra spaces around the text typed by the visitor.
        var query = SearchQuery.Trim();
        
        // With no search text, return given list.
        if (query.Length == 0)
        {
            return list;
        }
        
        // The result list
        List<ProductModel> resultList = [];
        
        // Search for Title, Description, and Maker
        foreach (var p in list)
        {
            // Concatenate all fields for searching
            var target = p.Title + " " + p.Description+ " " + p.Maker + " " + p.Author;
            if (ContainsSearchText(target, query))
            {
                resultList.Add(p);
            }
        }

        return resultList;
    }

    /// <summary>
    /// Keeps only the posts that belong to the selected genre.
    /// </summary>
    /// <param name="list">The posts to filter</param>
    /// <returns>The posts of the selected genre, or the given list when no genre is selected</returns>
    public List<ProductModel> GenreFilter(List<ProductModel> list)
    {
        // With no selected genre, return given list.
        if (GenreQuery == null)
        {
            return list;
        }
        
        // The result list
        List<ProductModel> resultList = [];
        
        // Search Genre
        foreach (var p in list)
        {
            if (p.Genre == GenreQuery)
            {
                resultList.Add(p);
            }
        }

        return resultList;
    }
    
    /// <summary>
    /// Check one field for a case-insensitive substring match.
    /// </summary>
    /// <param name="value"> search target</param>
    /// <param name="query"> the text you are searching search for</param>
    /// <returns></returns>
    public static bool ContainsSearchText(string value, string query)
    {
        // Empty fields cannot match; ignore letter casing in the comparison.
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }
        
        // If true, happy path
        return value.Contains(query, System.StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Keep pagination valid when the live search query changes.
    /// </summary>
    public void ResetSearchPage()
    {
        CurrentPage = 1;
        RefreshFilteredProducts();
    }

    /// <summary>
    /// Clear the query and restore the complete post list.
    /// </summary>
    public void ClearSearch()
    {
        // Set query properties to default to display all posts
        SearchQuery = string.Empty;
        GenreQuery = null;

        // Back to page 1
        CurrentPage = 1;

        RefreshFilteredProducts();
    }

    /// <summary>
    /// Remove only the genre filter and keep the search text.
    /// </summary>
    public void ResetGenre()
    {
        GenreQuery = null;

        // Back to page 1
        CurrentPage = 1;

        RefreshFilteredProducts();
    }

    
    /// <summary>
    /// Closes the game post modal by clearing the selected product.
    /// </summary>
    public void CloseProductModal()
    {
        SelectedProduct = null;
    }
    
    /// <summary>
    /// Finds the game post with the given id, stores it as the selected post
    /// to show in the modal, and loads its current rating.
    /// </summary>
    /// <param name="productId">Id of the product the user clicked</param>
    public void SelectProduct(string productId)
    {

        // Look the post up; it may have been deleted since the list was shown
        var product = ProductService.GetAllData().FirstOrDefault(x => x.Id == productId);

        // Fast fail: the post is gone, so close the popup, say so, and refresh the list
        if (product == null)
        {
            SelectedProduct = null;
            SelectedProductId = null;
            ProductMessage = "This post no longer exists. It may have been deleted.";
            RefreshFilteredProducts();
            return;
        }

        ProductMessage = null;
        SelectedProductId = productId;
        SelectedProduct = product;
        GetCurrentRating();
    }
    
    /// <summary>
    /// Calculates the vote count, the vote label, and the average rating of the selected game post.
    /// </summary>
    public void GetCurrentRating()
    {
        // Fast fail
        // If the selected product has no ratings, set the current rating and vote count to 0.
        if (SelectedProduct.Ratings == null)
        {
            CurrentRating = 0;
            VoteCount = 0;
            System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
            return;
        }
        // Calculate the vote count
        VoteCount = SelectedProduct.Ratings.Count();
        // Prevent 0 divition
        if (VoteCount == 0)
        {
            VoteLabel = "Vote";
            CurrentRating = 0;
            return;
        }

        VoteLabel = "Vote";
        if (VoteCount > 1)
        {
            VoteLabel = "Votes";
        }
        // Calculate the average rating, round the result to the closet integer.
        CurrentRating = (int)Math.Round((decimal)SelectedProduct.Ratings.Sum() / VoteCount, MidpointRounding.AwayFromZero);
        
        System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
        System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {(decimal)SelectedProduct.Ratings.Sum() / VoteCount}");
    }
    
    /// <summary>
    /// Saves a new rating for the selected game post, then reloads the post
    /// so the stars and vote count are updated.
    /// </summary>
    /// <param name="rating">Number of stars the user clicked (1 to 5)</param>
    public void SubmitRating(int rating)
    {
        System.Console.WriteLine($"Rating received for {SelectedProduct.Id}: {rating}");
        ProductService.AddRating(SelectedProductId, rating);
        SelectProduct(SelectedProductId);
    }
    
    /// <summary>
    /// Goes to the previous page of game posts, if there is one.
    /// </summary>
    public void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    /// <summary>
    /// Goes to the previous page of game posts, if there is one.
    /// </summary>
    public void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }

    /// <summary>
    /// Remove the submitted comment in the input field
    /// </summary>
    public void RefreshCommentInput()
    {
        NewCommentText = "";
    }
    
    /// <summary>
    /// Remember the new comment text
    /// </summary>
    /// <param name="newCommentText"> the new comment text</param>
    public void UpdateCommentText(string newCommentText)
    {
        NewCommentText = newCommentText;
    }

    /// <summary>
    /// Give the comment a like
    /// </summary>
    /// <param name="comment"> the comment you give the like to</param>
    public void LikeComment(CommentModel comment)
    {
        // Give the comment a like
        ProductService.AddCommentLikeOrDislike(SelectedProductId, comment.Id, 1, 0);
        
        // Refresh the selected post to display the latest comment state
        SelectProduct(SelectedProductId); 
    }
    
    /// <summary>
    /// Give the comment a dislike
    /// </summary>
    /// /// <param name="comment"> the comment you give the dislike to</param>
    public void DislikeComment(CommentModel comment)
    {
        // Give the comment a dislike
        ProductService.AddCommentLikeOrDislike(SelectedProductId, comment.Id, 0, 1);
        
        // Refresh the selected post to display the latest comment state
        SelectProduct(SelectedProductId); 
    }

}