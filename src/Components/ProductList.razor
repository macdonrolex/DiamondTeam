@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService
@using Microsoft.AspNetCore.Components
@* Live search controls for front-page posts. *@
<div class="product-search mb-4" role="search">
    <label for="post-search" class="sr-only">Search game posts</label>
    <div class="input-group">
        <div class="input-group-prepend"><span class="input-group-text" aria-hidden="true">&#128269;</span></div>
        @* Bind each keystroke to the search text and reset pagination afterward. *@
        <input id="post-search" class="form-control" type="search" placeholder="Search posts by title or text..." @bind="SearchQuery" @bind:event="oninput" @bind:after="ResetSearchPage" />
        @if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            <div class="input-group-append"><button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" id="Clear">Clear</button></div>
        }
    </div>
    <small class="form-text text-muted">@FilteredProducts.Count() posts found</small>
    @if (!FilteredProducts.Any())
    {
        <div class="alert alert-info text-center mt-3" role="status">No matching posts found.</div>
    }
</div>

<div class="card-columns">
@* Display only the matching posts on the current page. *@
@foreach (var product in FilteredProducts.Skip((CurrentPage - 1) * PageSize).Take(PageSize))
    {
         <div class="card game-card border-0">
            <div class="card-img game-card-image" style="background-image: url('@product.Image');">
                <div class="game-card-title">@product.Title</div>
            </div>
            <div class="game-card-menu">
                <button class="game-card-more-info" type="button" @onclick="(e => SelectProduct(product.Id))" id="MoreInfoButton_@product.Id"data-toggle="modal" data-target="#productModal">More Info</button>
            </div>
        </div>
    }
</div>
<div class="product-pager" aria-label="Product pages">
    <button class="pager-button pager-prev" type="button" @onclick="PreviousPage" disabled="@(CurrentPage == 1)" id="previousButton">
        <span aria-hidden="true">&larr;</span> Previous
    </button>
    <span class="pager-status">Page @CurrentPage of @TotalPages</span>
    <button class="pager-button pager-next" type="button" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" id="NextButton">
        Next <span aria-hidden="true">&rarr;</span>
    </button>
</div>
@* Modal for displaying the selected product's details. *@

@if (SelectedProduct != null)
{
    <div class="modal-backdrop fade show" @onclick="CloseProductModal"></div>
    <div class="modal fade show d-block" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@SelectedProduct.Title</h5>
                    <button type="button" class="close" @onclick="CloseProductModal" aria-label="Close">
                        <span aria-hidden="true" id="xButton">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card">
                        <div class="card-img" style="background-image: url('@SelectedProduct.Image');">
                        </div>
                        <div class="card-body">
                            <p class="card-text">@SelectedProduct.Description</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @* The Add Comment button*@
                    <div class="col">
                        <button @onclick="(e => ShowNewCommentInput())" id="AddComment" class="btn btn-primary">Add Comment</button>
                    </div>
                    @{
                        string voteText = VoteCount + " " + VoteLabel;
                        if (VoteCount == 0)
                        {
                            voteText = "Be the first to vote!";
                        }
                        <span>@voteText</span>
                    }
                    @for (int i = 1; i < 6; i++)
                    {
                        // Current star button to display
                        var currentStar = i;
                        // The class for star button
                        string starClass = "fa fa-star";

                        // Example: CurrentRating = 3. It means we need to make the first 3 stars checked(shiny)
                        if (currentStar <= CurrentRating)
                        {
                            starClass = "fa fa-star checked";
                        }

                        <span class=@starClass @onclick="(e => SubmitRating(currentStar))"></span>
                    }
                </div>
                @* Show input field after clicking the Add Comment button*@
                @if (NewComment)
                {
                    <div class="row" >
                        <div class="col">
                            <input type="text" @onchange="(e) => UpdateCommentText(e.Value.ToString())" value="@NewCommentText" />
                            @* Clicking the Save Comment button will close the input field by seeting the NewComment flag*@
                            <button @onclick="(e) => { ProductService.AddCommentToProduct(SelectedProduct, NewCommentText); 
                                        NewComment = false; }" class="btn btn-success" data-toggle="modal" id="SaveComment">Save Comment</button>
                        </div>
                    </div>
                }
                @* Display all comments *@
                @foreach (var comment in SelectedProduct.CommentList)
                {
                    <div class="row">
                        <div class="col">
                            @comment.Comment
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

@code
{   
    // Currently displayed game post
    public ProductModel SelectedProduct;
    // Id of the game post
    public string SelectedProductId;
    // Average rating of the selected game post
    public int CurrentRating = 0;
    // Number of votes the selected game post has received
    public int VoteCount = 0;
    // Text shown next to the vote count ("Vote" or "Votes")
    public string VoteLabel;
    // Number of game posts shown on each page
    public const int PageSize = 6;
    // Page currently displayed, starting from 1
    public int CurrentPage = 1;
    // Whether to display the comment input box
    public bool NewComment = false;
    // The new comment text to store
    public string NewCommentText;
    // Total number of pages, calculated from the number of game posts (at least 1)
    public int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredProducts.Count() / (double)PageSize));
    // Text used to filter home-page posts as the visitor types.
    public string SearchQuery { get; set; } = string.Empty;
    // Cache filtered posts so each render avoids rereading the JSON file.
    public List<ProductModel> FilteredProducts { get; set; } = new();

    // Load the posts when Blazor first creates this component.
    protected override void OnInitialized()
    {
        RefreshFilteredProducts();
    }

    /// <summary>
    /// Rebuild the list of posts that match the current search text.
    /// </summary>
    public void RefreshFilteredProducts()
    {
        // Remove extra spaces around the text typed by the visitor.
        var query = SearchQuery.Trim();
        // Get the full list before applying the search filter.
        var products = ProductService.GetAllData().ToList();
        
        // With no search text, display every post.
        if (query.Length == 0)
        {
            FilteredProducts = products.ToList();
            return;
        }
        
        // Removed old filtered results
        FilteredProducts.Clear();
        
        // Search for Title, Descriptionm, Maker, and Genre
        foreach (var p in products)
        {
            // Concatenate all fields for searching
            var target = p.Title + " " + p.Description+ " " + p.Maker+ " " + p.Genre.DisplayGenre();
            if (ContainsSearchText(target, query))
            {
                FilteredProducts.Add(p);
            }
        }
    }
    
    /// <summary>
    /// Check one field for a case-insensitive substring match.
    /// </summary>
    /// <param name="value"> search target</param>
    /// <param name="query"> the text you are searching search for</param>
    /// <returns></returns>
    public static bool ContainsSearchText(string value, string query)
    {
        // Empty fields cannot match; ignore letter casing in the comparison.
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }
        
        // If true, happy path
        return value.Contains(query, System.StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Keep pagination valid when the live search query changes.
    /// </summary>
    public void ResetSearchPage()
    {
        CurrentPage = 1;
        RefreshFilteredProducts();
    }

    /// <summary>
    /// Clear the query and restore the complete post list.
    /// </summary>
    public void ClearSearch()
    {
        SearchQuery = string.Empty;
        CurrentPage = 1;
        RefreshFilteredProducts();
    }
    
    
    /// <summary>
    /// Closes the game post modal by clearing the selected product.
    /// </summary>
    public void CloseProductModal()
    {
        SelectedProduct = null;
    }
    
    /// <summary>
    /// Finds the game post with the given id, stores it as the selected post
    /// to show in the modal, and loads its current rating.
    /// </summary>
    /// <param name="productId">Id of the product the user clicked</param>
    public void SelectProduct(string productId)
    {
        SelectedProductId = productId;
        SelectedProduct = ProductService.GetAllData().First(x => x.Id == productId);
        GetCurrentRating();
    }
    
    /// <summary>
    /// Calculates the vote count, the vote label, and the average rating of the selected game post.
    /// </summary>
    public void GetCurrentRating()
    {
        // Fast fail
        // If the selected product has no ratings, set the current rating and vote count to 0.
        if (SelectedProduct.Ratings == null)
        {
            CurrentRating = 0;
            VoteCount = 0;
            System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
            return;
        }
        // Calculate the vote count
        VoteCount = SelectedProduct.Ratings.Count();
        // Prevent 0 divition
        if (VoteCount == 0)
        {
            return;
        }

        VoteLabel = "Vote";
        if (VoteCount > 1)
        {
            VoteLabel = "Votes";
        }
        // Calculate the average rating
        CurrentRating = SelectedProduct.Ratings.Sum() / VoteCount;
        
        System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
    }
    
    /// <summary>
    /// Saves a new rating for the selected game post, then reloads the post
    /// so the stars and vote count are updated.
    /// </summary>
    /// <param name="rating">Number of stars the user clicked (1 to 5)</param>
    public void SubmitRating(int rating)
    {
        System.Console.WriteLine($"Rating received for {SelectedProduct.Id}: {rating}");
        ProductService.AddRating(SelectedProductId, rating);
        SelectProduct(SelectedProductId);
    }
    
    /// <summary>
    /// Goes to the previous page of game posts, if there is one.
    /// </summary>
    public void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    /// <summary>
    /// Goes to the previous page of game posts, if there is one.
    /// </summary>
    public void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }
    
    /// <summary>
    /// Show the Input Entry Box, and remove the old text
    /// </summary>
    public void ShowNewCommentInput()
    {
        // Setting the new comment flag to true will show the input box
        NewComment = true;

        NewCommentText = "";
    }
    
    /// <summary>
    /// Remember the new comment text
    /// </summary>
    /// <param name="newCommentText"> the new comment text</param>
    public void UpdateCommentText(string newCommentText)
    {
        NewCommentText = newCommentText;
    }

}
