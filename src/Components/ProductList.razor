@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService

<div class="card-columns">
@foreach (var product in ProductService.GetAllData().Skip((CurrentPage - 1) * PageSize).Take(PageSize))
    {
         <div class="card game-card border-0">
            <div class="card-img game-card-image" style="background-image: url('@product.Image');">
                <div class="game-card-title">@product.Title</div>
            </div>
            <div class="game-card-menu">
                <button class="game-card-more-info" type="button" @onclick="(e => SelectProduct(product.Id))" data-toggle="modal" data-target="#productModal">More Info</button>



  

            </div>
        </div>
    }
</div>
<div class="product-pager" aria-label="Product pages">
    <button class="pager-button pager-prev" type="button" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">
        <span aria-hidden="true">&larr;</span> Previous
    </button>
    <span class="pager-status">Page @CurrentPage of @TotalPages</span>
    <button class="pager-button pager-next" type="button" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">
        Next <span aria-hidden="true">&rarr;</span>
    </button>
</div>

@if (SelectedProduct != null)
{
    <div class="modal-backdrop fade show" @onclick="CloseProductModal"></div>
    <div class="modal fade show d-block" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@SelectedProduct.Title</h5>
                    <button type="button" class="close" @onclick="CloseProductModal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card">
                        <div class="card-img" style="background-image: url('@SelectedProduct.Image');">
                        </div>
                        <div class="card-body">
                            <p class="card-text">@SelectedProduct.Description</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (VoteCount == 0)
                    {
                        <span>Be the first to vote!</span>
                    }
                    else
                    {
                        <span>@VoteCount @VoteLabel</span>
                    }
                    @for (int i = 1; i < 6; i++)
                    {
                        var currentStar = i;
                        if (i <= CurrentRating)
                        {
                            <span class="fa fa-star checked" @onclick="(e => SubmitRating(currentStar))"></span>
                        }
                        else
                        {
                            <span class="fa fa-star" @onclick="(e => SubmitRating(currentStar))"></span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

@code
{   
    // Currently displayed game post
    public ProductModel SelectedProduct;
    // Id of the game post
    public string SelectedProductId;
    // Average rating of the selected game post
    public int CurrentRating = 0;
    // Number of votes the selected game post has received
    public int VoteCount = 0;
    // Text shown next to the vote count ("Vote" or "Votes")
    public string VoteLabel;
    // Number of game posts shown on each page
    public const int PageSize = 6;
    // Page currently displayed, starting from 1
    public int CurrentPage = 1;
    // Total number of pages, calculated from the number of game posts (at least 1)
    public int TotalPages => Math.Max(1, (int)Math.Ceiling(ProductService.GetAllData().Count() / (double)PageSize));
    
    void CloseProductModal()
    {
        SelectedProduct = null;
    }

    void SelectProduct(string productId)
    {
        SelectedProductId = productId;
        SelectedProduct = ProductService.GetAllData().First(x => x.Id == productId);
        GetCurrentRating();
    }
    
    void GetCurrentRating()
    {
        if (SelectedProduct.Ratings == null)
        {
            CurrentRating = 0;
            VoteCount = 0;
        }
        else
        {
            VoteCount = SelectedProduct.Ratings.Count();
            VoteLabel = VoteCount > 1 ? "Votes" : "Vote";
            CurrentRating = SelectedProduct.Ratings.Sum() / VoteCount;
        }

        System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
    }

    void SubmitRating(int rating)
    {
        System.Console.WriteLine($"Rating received for {SelectedProduct.Id}: {rating}");
        ProductService.AddRating(SelectedProductId, rating);
        SelectProduct(SelectedProductId);
    }
    
    void PreviousPage()
    {
        if (CurrentPage > 1) CurrentPage--;
    }

    void NextPage()
    {
        if (CurrentPage < TotalPages) CurrentPage++;
    }
}
